#!/usr/bin/env bash
# ccs — pick which Claude account (Max, company Team seats, …) Claude Code and
# Hermes use, per terminal. Two terminals can run on two accounts at once.
#
# Per account:
#   Claude Code  → its own config dir (~/.claude-<name>) via CLAUDE_CONFIG_DIR
#   Hermes       → its own profile (~/.hermes/profiles/<name>) holding that
#                  account's own Claude login; skills + memories shared
# The pre-existing setup (~/.claude + default Hermes profile) is the default account.
set -euo pipefail

VERSION="0.2.0"
CCS_HOME="${CCS_HOME:-$HOME/.config/ccs}"
REG="$CCS_HOME/accounts.tsv"          # name<TAB>claude_dir<TAB>hermes_profile<TAB>email
HERMES_ROOT="${CCS_HERMES_ROOT:-$HOME/.hermes}"
DEFAULT_CLAUDE_DIR="$HOME/.claude"
SHARED_CLAUDE_ITEMS=(CLAUDE.md settings.json commands agents skills hooks plugins output-styles)
SHARED_HERMES_ITEMS=(skills memories)
PY="/usr/bin/python3"; command -v "$PY" >/dev/null 2>&1 || PY="python3"

die()  { printf 'ccs: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ccs: UYARI: %s\n' "$*" >&2; }
say()  { printf '%s\n' "$*"; }

# ── registry ─────────────────────────────────────────────────────────────────
ensure_registry() {
  mkdir -p "$CCS_HOME"
  [[ -f "$REG" ]] || printf 'default\t%s\tdefault\t\n' "$DEFAULT_CLAUDE_DIR" > "$REG"
  # v0.1 rows had 3 columns; pad the email column.
  awk -F'\t' -v OFS='\t' 'NF==3{$4=""} {print}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
}

lookup() {   # NAME → ACC_NAME ACC_DIR ACC_PROFILE ACC_EMAIL
  local line
  line="$(awk -F'\t' -v n="$1" '$1==n {print; exit}' "$REG")"
  [[ -n "$line" ]] || return 1
  IFS=$'\t' read -r ACC_NAME ACC_DIR ACC_PROFILE ACC_EMAIL <<<"$line" || true
}
need_account() { lookup "$1" || die "'$1' diye bir hesap yok. Kayıtlı: $(cut -f1 "$REG" | paste -sd, -)"; }
is_default()   { [[ "$ACC_PROFILE" == "default" ]]; }
profile_home() { if is_default; then printf '%s' "$HERMES_ROOT"; else printf '%s/profiles/%s' "$HERMES_ROOT" "$ACC_PROFILE"; fi; }
valid_name()   { [[ "$1" =~ ^[a-z][a-z0-9]{0,23}$ ]] || die "ad küçük harf + rakam olmalı (örn. max, viby): '$1'"; }
default_name() { awk -F'\t' '$3=="default"{print $1; exit}' "$REG"; }
set_email()    { awk -F'\t' -v OFS='\t' -v n="$1" -v e="$2" '$1==n{$4=e} {print}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"; }

# Default account: CLAUDE_CONFIG_DIR must stay UNSET. Claude Code picks its
# Keychain item from that variable, so even pointing it at ~/.claude logs you out.
apply_env() {
  export CCS_ACCOUNT="$ACC_NAME"
  if is_default; then unset CLAUDE_CONFIG_DIR HERMES_HOME
  else export CLAUDE_CONFIG_DIR="$ACC_DIR" HERMES_HOME="$(profile_home)"; fi
}

# ── identity (secrets never printed) ─────────────────────────────────────────
# Prints "email<TAB>org<TAB>org_type" for a Hermes profile's own login, the
# default profile's borrowed ~/.claude login, or nothing.
hermes_identity() {
  "$PY" - "$(profile_home)" "$ACC_PROFILE" "$ACC_DIR" <<'PY'
import json, sys, time, pathlib, urllib.request
home, profile, cdir = pathlib.Path(sys.argv[1]), sys.argv[2], pathlib.Path(sys.argv[3])
tok = ""
try:
    rows = json.loads((home / "auth.json").read_text()).get("credential_pool", {}).get("anthropic", [])
except Exception:
    rows = []
own = [r for r in rows if r.get("source") != "claude_code"]
if own:
    r = own[0]
    if r.get("access_token") and (r.get("expires_at_ms") or 0) > time.time() * 1000 + 60_000:
        tok = r["access_token"]
    elif r.get("access_token"):
        print("?\tsüresi dolmuş token, ilk kullanımda yenilenir\t"); sys.exit()
elif profile == "default":
    try:
        c = json.loads((cdir / ".credentials.json").read_text())["claudeAiOauth"]
        if c.get("expiresAt", 0) > time.time() * 1000 + 60_000:
            tok = c["accessToken"]
    except Exception:
        pass
if not tok:
    sys.exit()
try:
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/profile",
        headers={"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
    d = json.load(urllib.request.urlopen(req, timeout=10))
    a, o = d.get("account") or {}, d.get("organization") or {}
    print(f"{a.get('email','?')}\t{o.get('name','?')}\t{o.get('organization_type','?')}")
except Exception as e:
    print(f"?\tsorgulanamadı ({type(e).__name__})\t")
PY
}

hermes_has_own_login() {
  "$PY" - "$(profile_home)" <<'PY'
import json, sys, pathlib
try:
    rows = json.loads((pathlib.Path(sys.argv[1]) / "auth.json").read_text()).get("credential_pool", {}).get("anthropic", [])
except Exception:
    rows = []
sys.exit(0 if any(r.get("source") != "claude_code" for r in rows) else 1)
PY
}

claude_identity() {   # "email<TAB>org<TAB>plan" or nothing
  ( apply_env; claude auth status 2>/dev/null || true ) | "$PY" -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit()
if d.get("loggedIn"):
    print("\t".join(str(d.get(k) or "?") for k in ("email", "orgName", "subscriptionType")))'
}

# Refuse to start Hermes on a non-default account without its own login: a
# profile with zero Anthropic credentials silently reads the default profile's
# pool, i.e. it would spend the default account's limits.
hermes_guard() {
  is_default && return 0
  [[ -d "$(profile_home)" ]] || die "$ACC_NAME için Hermes profili yok → ccs add $ACC_NAME <email>"
  grep -qE '^\s*adopt_external_logins:\s*false' "$(profile_home)/config.yaml" 2>/dev/null \
    || die "$ACC_NAME profilinde auth.adopt_external_logins false değil → ccs add $ACC_NAME <email>"
  hermes_has_own_login || die "$ACC_NAME ($ACC_EMAIL) için Hermes girişi yok → ccs login $ACC_NAME"
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {    # ccs init <name> [email]: name the existing (default) setup
  local name="${1:-}" email="${2:-}"
  valid_name "$name"
  if lookup "$name" && ! is_default; then die "'$name' başka bir hesabın adı"; fi
  awk -F'\t' -v OFS='\t' -v n="$name" '$3=="default"{$1=n} {print}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
  [[ -n "$email" ]] && set_email "$name" "$email"
  say "✓ varsayılan hesap (~/.claude + Hermes default profili): $name ${email:+<$email>}"
}

cmd_add() {     # ccs add <name> <email> [--isolated]
  local name="" email="" isolated=0 a
  for a in "$@"; do
    case "$a" in
      --isolated) isolated=1 ;;
      -*) die "bilinmeyen seçenek: $a" ;;
      *@*) email="$a" ;;
      *) name="$a" ;;
    esac
  done
  [[ -n "$email" ]] || die "kullanım: ccs add <ad> <email>   örn: ccs add viby tolga@viby.dev"
  [[ -n "$name" ]] || { name="$(printf '%s' "${email#*@}" | cut -d. -f1 | tr -cd 'a-z0-9')"; }
  valid_name "$name"
  if lookup "$name"; then
    is_default && die "'$name' varsayılan hesap"
    [[ -z "$ACC_EMAIL" || "$ACC_EMAIL" == "$email" ]] \
      || die "'$name' adı zaten $ACC_EMAIL için kullanılıyor; başka bir ad ver: ccs add <ad> $email"
  fi

  local dir="$HOME/.claude-$name" phome="$HERMES_ROOT/profiles/$name" created=0 item

  mkdir -p "$dir"; chmod 700 "$dir"
  for item in "${SHARED_CLAUDE_ITEMS[@]}"; do
    if [[ -e "$DEFAULT_CLAUDE_DIR/$item" && ! -e "$dir/$item" && ! -L "$dir/$item" ]]; then
      ln -s "$DEFAULT_CLAUDE_DIR/$item" "$dir/$item"
    fi
  done

  if [[ ! -d "$phome" ]]; then
    hermes profile create "$name" --clone --no-alias \
      --description "Same agent on Claude account $email (managed by ccs)." >/dev/null
    created=1
  fi
  hermes -p "$name" config set auth.adopt_external_logins false >/dev/null
  if [[ -f "$phome/.env" ]] && grep -qE '^(ANTHROPIC_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=' "$phome/.env"; then
    sed -i '' -E '/^(ANTHROPIC_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=/d' "$phome/.env"
  fi
  if (( ! isolated )); then
    for item in "${SHARED_HERMES_ITEMS[@]}"; do
      local target="$HERMES_ROOT/$item" link="$phome/$item"
      [[ -e "$target" && ! -L "$link" ]] || continue
      if [[ -e "$link" ]]; then
        if (( created )); then rm -rf "$link"; else mv "$link" "$link.ccs-backup-$(date +%Y%m%d%H%M%S)"; fi
      fi
      ln -s "$target" "$link"
    done
  fi

  if lookup "$name"; then set_email "$name" "$email"
  else printf '%s\t%s\t%s\t%s\n' "$name" "$dir" "$name" "$email" >> "$REG"; fi

  say "✓ '$name' <$email> eklendi (Claude Code: ${dir/#$HOME/~}, Hermes profili: $name)"
  say "  Şimdi giriş yap:  ccs login $name"
}

# Log in and VERIFY the account matches the registered email; a wrong account
# is logged out / removed again so it can never be used by mistake.
cmd_login() {
  local name="${1:-}" which="${2:-all}"
  [[ -n "$name" ]] || die "kullanım: ccs login <ad> [claude|hermes|all]"
  need_account "$name"
  local want="$ACC_EMAIL" got
  [[ -n "$want" ]] || warn "$name için kayıtlı email yok; hesap doğrulaması yapılamaz (ccs add $name <email>)"
  say "Tarayıcıda claude.ai başka bir hesapla açıksa önce oradan hesap değiştir"
  say "ya da linki gizli pencerede aç. Giriş yapılacak hesap: ${want:-?}"
  say ""

  if [[ "$which" == claude || "$which" == all ]]; then
    say "── 1) Claude Code girişi ($name)"
    ( apply_env; claude auth login ${want:+--email "$want"} ) || warn "Claude Code girişi tamamlanmadı"
    got="$(claude_identity | cut -f1)"
    if [[ -n "$want" && -n "$got" && "$got" != "$want" ]]; then
      ( apply_env; claude auth logout >/dev/null 2>&1 || true )
      warn "Claude Code $got ile giriş yaptı, $want bekleniyordu → çıkış yapıldı. Tekrar dene: ccs login $name claude"
    elif [[ -n "$got" ]]; then say "✓ Claude Code: $got"; fi
  fi

  if [[ "$which" == hermes || "$which" == all ]]; then
    if is_default; then
      say "── 2) Hermes ($name) ~/.claude girişini kullanıyor, ayrı giriş gerekmiyor"
    else
      say "── 2) Hermes girişi ($name): link açılınca $want ile onayla, çıkan kodu buraya yapıştır"
      local after
      hermes -p "$ACC_PROFILE" auth add anthropic --type oauth --label "ccs-$name" || warn "Hermes girişi tamamlanmadı"
      after="$(hermes_identity | cut -f1 || true)"
      if [[ -n "$want" && -n "$after" && "$after" != "?" && "$after" != "$want" ]]; then
        hermes -p "$ACC_PROFILE" auth remove anthropic "ccs-$name" >/dev/null 2>&1 || true
        warn "Hermes $after ile giriş yaptı, $want bekleniyordu → bu giriş silindi. Tekrar dene: ccs login $name hermes"
      elif [[ -n "$after" ]]; then say "✓ Hermes: $after"; fi
    fi
  fi
  say ""
  cmd_status "$name"
}

cmd_status() {
  local names=() n
  if [[ $# -gt 0 ]]; then names=("$@"); else while IFS=$'\t' read -r n _; do names+=("$n"); done < "$REG"; fi
  for n in "${names[@]}"; do
    need_account "$n"
    local cc hm mark=""
    [[ "${CCS_ACCOUNT:-}" == "$ACC_NAME" ]] && mark="  ← bu terminal"
    say "● $ACC_NAME  <${ACC_EMAIL:-email kayıtlı değil}>$mark"
    cc="$(claude_identity)"
    if [[ -n "$cc" ]]; then say "    Claude Code : ${cc//$'\t'/ · }$(mismatch "${cc%%$'\t'*}")"
    else say "    Claude Code : giriş yok  → ccs login $ACC_NAME claude"; fi
    if ! is_default && ! hermes_has_own_login; then
      say "    Hermes      : giriş yok (açılmaz)  → ccs login $ACC_NAME hermes"
    else
      hm="$(hermes_identity)"
      if [[ -n "$hm" ]]; then say "    Hermes      : ${hm//$'\t'/ · }$(mismatch "${hm%%$'\t'*}")"
      else say "    Hermes      : giriş bulunamadı"; fi
    fi
  done
}
mismatch() { [[ -n "$ACC_EMAIL" && "$1" != "?" && "$1" != "$ACC_EMAIL" ]] && printf '   ⚠ YANLIŞ HESAP (beklenen %s)' "$ACC_EMAIL" || true; }

# Interactive account menu on the terminal; prints the chosen name on stdout.
cmd_pick() {
  local cur="${CCS_ACCOUNT:-$(default_name)}" i=0 names=() n d p e choice
  exec 3</dev/tty 4>/dev/tty || die "terminal yok"
  printf 'Claude hesabı:\n' >&4
  while IFS=$'\t' read -r n d p e; do
    i=$((i+1)); names+=("$n")
    printf '  %d) %-8s %s%s\n' "$i" "$n" "${e:-?}" "$([[ "$n" == "$cur" ]] && printf '   (Enter)')" >&4
  done < "$REG"
  printf 'Seçim: ' >&4
  IFS= read -r choice <&3 || exit 1
  [[ -z "$choice" ]] && { printf '%s\n' "$cur"; return; }
  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#names[@]} )); then
    printf '%s\n' "${names[$((choice-1))]}"; return
  fi
  for n in "${names[@]}"; do [[ "$n" == "$choice" ]] && { printf '%s\n' "$n"; return; }; done
  die "geçersiz seçim: $choice"
}

cmd_env() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "kullanım: ccs env <ad>"
  need_account "$name"
  hermes_guard
  if is_default; then printf 'unset CLAUDE_CONFIG_DIR HERMES_HOME; export CCS_ACCOUNT=%q\n' "$ACC_NAME"
  else printf 'export CLAUDE_CONFIG_DIR=%q HERMES_HOME=%q CCS_ACCOUNT=%q\n' "$ACC_DIR" "$(profile_home)" "$ACC_NAME"; fi
}

cmd_run() {
  local name="${1:-}"; shift || true
  [[ -n "$name" && $# -gt 0 ]] || die "kullanım: ccs run <ad> <komut…>"
  need_account "$name"
  apply_env
  [[ "$(basename "$1")" == hermes ]] && hermes_guard
  exec "$@"
}

cmd_shell_init() {
  cat <<'SH'
# ccs — `hermes` ve `claude` açılırken Claude hesabı sorar; seçim bu terminale yapışır.
# Sormasın istersen: export CCS_ASK=0  (o zaman `ccs use <ad>` ile seçersin)
_ccs_choose() {
  local _a _e
  _a="$(command ccs pick)" || return 1
  _e="$(command ccs env "$_a")" || return 1
  eval "$_e"
}
_ccs_should_ask() {   # $1 = tool, rest = args
  local tool="$1"; shift
  [ "${CCS_ASK:-1}" = 0 ] && return 1
  [ -t 0 ] && [ -t 1 ] || return 1
  local a; for a in "$@"; do
    case "$a" in -p|--profile|--profile=*) [ "$tool" = hermes ] && return 1 ;; esac
    case "$a" in -p|--print|-v|--version|-h|--help) [ "$tool" = claude ] && return 1 ;; esac
    case "$a" in --version|-V|-h|--help) return 1 ;; esac
  done
  [ $# -eq 0 ] && return 0
  case "$tool:$1" in
    hermes:chat|hermes:-*) return 0 ;;
    hermes:*) return 1 ;;
    claude:auth|claude:mcp|claude:update|claude:upgrade|claude:doctor|claude:install|claude:setup-token|claude:plugin|claude:plugins|claude:config|claude:migrate-installer) return 1 ;;
    claude:*) return 0 ;;
  esac
}
hermes() { if _ccs_should_ask hermes "$@"; then _ccs_choose || return 1; fi; command hermes "$@"; }
claude() { if _ccs_should_ask claude "$@"; then _ccs_choose || return 1; fi; command claude "$@"; }
ccs() {
  if [ "$1" = use ]; then
    local _e; _e="$(command ccs env "${2:?kullanım: ccs use <ad>}")" || return 1
    eval "$_e" && echo "ccs: bu terminal artık '$2' hesabında (claude + hermes)"
  else command ccs "$@"; fi
}
SH
}

cmd_list() {
  local n d p e
  while IFS=$'\t' read -r n d p e; do
    printf '%s %-8s %-28s claude: %-18s hermes: %s\n' "$([[ "$n" == "${CCS_ACCOUNT:-}" ]] && echo '*' || echo ' ')" \
      "$n" "${e:-?}" "${d/#$HOME/~}" "$p"
  done < "$REG"
}

cmd_remove() {
  local name="${1:-}" purge="${2:-}" item
  need_account "$name"
  is_default && die "varsayılan hesap silinemez"
  awk -F'\t' -v n="$name" '$1!=n' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
  rm -f "$HOME/.local/bin/claude-$name" "$HOME/.local/bin/hermes-$name"   # v0.1 wrappers
  if [[ "$purge" == --purge ]]; then
    local phome; phome="$(profile_home)"
    for item in "${SHARED_HERMES_ITEMS[@]}"; do [[ -L "$phome/$item" ]] && rm "$phome/$item"; done
    [[ -d "$phome" ]] && { hermes profile delete "$ACC_PROFILE" --yes >/dev/null 2>&1 || hermes profile delete "$ACC_PROFILE" </dev/null >/dev/null 2>&1 || warn "Hermes profili silinemedi: $ACC_PROFILE"; }
    if [[ -d "$ACC_DIR" ]]; then ( apply_env; claude auth logout >/dev/null 2>&1 || true ); find "$ACC_DIR" -maxdepth 1 -type l -delete; rm -rf "$ACC_DIR"; fi
    say "✓ $name tamamen silindi"
  else
    say "✓ $name listeden çıkarıldı (veri duruyor; tamamen silmek için --purge)"
  fi
}

usage() {
  cat <<EOF
ccs $VERSION — Claude Code ve Hermes için terminal başına Claude hesabı seçimi.

Kurulum (bir kez):
  ccs init max tolgazorlu17@gmail.com    mevcut kurulumun adı + emaili
  ccs add viby tolga@viby.dev            yeni hesap
  ccs login viby                         tarayıcıda giriş (Claude Code + Hermes), email doğrulanır

Günlük:
  hermes / claude      açılırken hangi hesap diye sorar; seçim o terminale yapışır
  ccs use <ad>         bu terminali sormadan o hesaba geçir
  ccs status           her hesabın gerçekte kime bağlı olduğu (Anthropic'e sorar)
  ccs list | whoami | remove <ad> [--purge] | run <ad> <komut…>
EOF
}

main() {
  ensure_registry
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    login) cmd_login "$@" ;;
    status) cmd_status "$@" ;;
    whoami) cmd_status "${CCS_ACCOUNT:-$(default_name)}" ;;
    list|ls) cmd_list ;;
    pick) cmd_pick ;;
    env) cmd_env "$@" ;;
    run) cmd_run "$@" ;;
    use) die "'ccs use' için .zshrc'de  eval \"\$(ccs shell-init)\"  olmalı (yeni terminal aç)" ;;
    shell-init) cmd_shell_init ;;
    remove|rm) cmd_remove "$@" ;;
    -v|--version|version) say "ccs $VERSION" ;;
    help|-h|--help) usage ;;
    *) die "bilinmeyen komut: $cmd  (ccs help)" ;;
  esac
}

main "$@"
