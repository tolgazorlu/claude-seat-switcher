#!/usr/bin/env bash
# ccs — run Claude Code and Hermes under several Claude accounts side by side.
#
# Each account gets:
#   - its own Claude Code config dir   (~/.claude-<name>, via CLAUDE_CONFIG_DIR)
#   - its own Hermes profile           (~/.hermes/profiles/<name>, own Anthropic login)
#   - wrappers                         claude-<name>, hermes-<name>
# The pre-existing setup (~/.claude + default Hermes profile) is the "default" account.
set -euo pipefail

VERSION="0.1.0"
CCS_HOME="${CCS_HOME:-$HOME/.config/ccs}"
REG="$CCS_HOME/accounts.tsv"
BIN_DIR="${CCS_BIN_DIR:-$HOME/.local/bin}"
HERMES_ROOT="${CCS_HERMES_ROOT:-$HOME/.hermes}"
DEFAULT_CLAUDE_DIR="$HOME/.claude"
# Shared between all accounts (symlinked from ~/.claude): rules, settings, commands, skills…
SHARED_CLAUDE_ITEMS=(CLAUDE.md settings.json commands agents skills hooks plugins output-styles)
# Shared between Hermes profiles unless --isolated (symlinked from the root profile).
SHARED_HERMES_ITEMS=(skills memories)
PY="/usr/bin/python3"; command -v "$PY" >/dev/null 2>&1 || PY="python3"

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/$(basename "$(readlink -f "${BASH_SOURCE[0]}")")"

die()  { printf 'ccs: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ccs: uyarı: %s\n' "$*" >&2; }
say()  { printf '%s\n' "$*"; }

# ── registry: name<TAB>claude_dir<TAB>hermes_profile ─────────────────────────
ensure_registry() {
  mkdir -p "$CCS_HOME"
  [[ -f "$REG" ]] || printf 'default\t%s\tdefault\n' "$DEFAULT_CLAUDE_DIR" > "$REG"
}

# lookup NAME -> sets ACC_NAME ACC_DIR ACC_PROFILE; returns 1 if missing
lookup() {
  local line
  line="$(awk -F'\t' -v n="$1" '$1==n {print; exit}' "$REG")"
  [[ -n "$line" ]] || return 1
  IFS=$'\t' read -r ACC_NAME ACC_DIR ACC_PROFILE <<<"$line"
}

need_account() { lookup "$1" || die "'$1' diye bir hesap yok. Kayıtlı hesaplar: $(cut -f1 "$REG" | paste -sd, -)"; }
is_default()   { [[ "$ACC_PROFILE" == "default" ]]; }
profile_home() { if is_default; then printf '%s' "$HERMES_ROOT"; else printf '%s/profiles/%s' "$HERMES_ROOT" "$ACC_PROFILE"; fi; }
valid_name()   { [[ "$1" =~ ^[a-z][a-z0-9]{0,23}$ ]] || die "hesap adı küçük harf + rakam olmalı (örn. team, work2): '$1'"; }

# ── env for an account ───────────────────────────────────────────────────────
# Default account: CLAUDE_CONFIG_DIR must be UNSET (setting it, even to ~/.claude,
# makes Claude Code use a different Keychain item and look logged out).
apply_env() {
  export CCS_ACCOUNT="$ACC_NAME"
  if is_default; then
    unset CLAUDE_CONFIG_DIR HERMES_HOME
  else
    export CLAUDE_CONFIG_DIR="$ACC_DIR"
    export HERMES_HOME="$(profile_home)"
  fi
}

# Refuse to start Hermes on a non-default account unless it has its OWN Anthropic
# login and does not borrow ~/.claude. A profile with zero Anthropic credentials
# silently falls back to the root profile's pool, i.e. the default account.
hermes_guard() {
  is_default && return 0
  local home; home="$(profile_home)"
  [[ -d "$home" ]] || die "Hermes profili yok: $home  →  ccs add $ACC_NAME"
  "$PY" - "$home" <<'PY' || exit 1
import json, sys, re, pathlib
home = pathlib.Path(sys.argv[1])
cfg = (home / "config.yaml").read_text() if (home / "config.yaml").exists() else ""
m = re.search(r"^\s*adopt_external_logins:\s*(\S+)", cfg, re.M)
if not m or m.group(1).lower() not in ("false", "no", "off"):
    sys.exit(f"ccs: {home.name} profilinde auth.adopt_external_logins false değil; varsayılan hesaba kayabilir. Düzelt: ccs add {home.name}")
try:
    pool = json.loads((home / "auth.json").read_text()).get("credential_pool", {})
except Exception:
    pool = {}
own = [r for r in pool.get("anthropic", []) if r.get("source") != "claude_code"]
if not own:
    sys.exit(f"ccs: {home.name} profilinin kendi Claude girişi yok; açılırsa varsayılan hesabı kullanır. Önce: ccs login {home.name} hermes")
PY
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_add() {
  local name="" isolated=0
  for a in "$@"; do
    case "$a" in
      --isolated) isolated=1 ;;
      -*) die "bilinmeyen seçenek: $a" ;;
      *) name="$a" ;;
    esac
  done
  [[ -n "$name" ]] || die "kullanım: ccs add <ad> [--isolated]"
  valid_name "$name"
  [[ "$name" != "default" ]] || die "'default' ayrılmış"
  if lookup "$name" && is_default; then die "'$name' varsayılan hesabın adı"; fi

  local dir="$HOME/.claude-$name" phome="$HERMES_ROOT/profiles/$name" created=0

  # 1) Claude Code config dir, shared bits symlinked from ~/.claude
  mkdir -p "$dir"; chmod 700 "$dir"
  for item in "${SHARED_CLAUDE_ITEMS[@]}"; do
    if [[ -e "$DEFAULT_CLAUDE_DIR/$item" && ! -e "$dir/$item" && ! -L "$dir/$item" ]]; then
      ln -s "$DEFAULT_CLAUDE_DIR/$item" "$dir/$item"
    fi
  done
  say "✓ Claude Code klasörü: $dir (ortak: ${SHARED_CLAUDE_ITEMS[*]})"

  # 2) Hermes profile with its own Anthropic login
  if command -v hermes >/dev/null 2>&1; then
    if [[ ! -d "$phome" ]]; then
      hermes profile create "$name" --clone --no-alias \
        --description "Same agent, Claude account '$name' (managed by ccs)." >/dev/null
      created=1
    fi
    # Never borrow ~/.claude (that is the default account's login).
    hermes -p "$name" config set auth.adopt_external_logins false >/dev/null
    # A cloned .env must not carry the default account's Anthropic token.
    if [[ -f "$phome/.env" ]] && grep -qE '^(ANTHROPIC_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=' "$phome/.env"; then
      sed -i '' -E '/^(ANTHROPIC_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=/d' "$phome/.env"
      say "✓ profil .env'inden Anthropic anahtarları çıkarıldı"
    fi
    if (( ! isolated )); then
      for item in "${SHARED_HERMES_ITEMS[@]}"; do
        local target="$HERMES_ROOT/$item" link="$phome/$item"
        [[ -e "$target" ]] || continue
        [[ -L "$link" ]] && continue
        if [[ -e "$link" ]]; then
          if (( created )); then rm -rf "$link"; else mv "$link" "$link.ccs-backup-$(date +%Y%m%d%H%M%S)"; fi
        fi
        ln -s "$target" "$link"
      done
      say "✓ Hermes profili: $phome (skills + memories varsayılanla ortak)"
    else
      say "✓ Hermes profili: $phome (izole: kendi skills/memories)"
    fi
  else
    warn "hermes bulunamadı; yalnız Claude Code tarafı kuruldu"
  fi

  # 3) registry + wrappers
  if ! lookup "$name"; then printf '%s\t%s\t%s\n' "$name" "$dir" "$name" >> "$REG"; fi
  write_wrappers "$name"

  say ""
  say "Sıradaki adım (tarayıcıda $name hesabıyla giriş):  ccs login $name"
}

write_wrappers() {
  local name="$1"
  mkdir -p "$BIN_DIR"
  for tool in claude hermes; do
    local w="$BIN_DIR/$tool-$name"
    printf '#!/bin/sh\n# generated by ccs — %s on Claude account "%s"\nexec "%s" run %s %s "$@"\n' \
      "$tool" "$name" "$SELF" "$name" "$tool" > "$w"
    chmod +x "$w"
  done
  say "✓ komutlar: claude-$name, hermes-$name  ($BIN_DIR)"
}

cmd_login() {
  local name="${1:-}" which="${2:-all}"
  [[ -n "$name" ]] || die "kullanım: ccs login <ad> [claude|hermes|all]"
  need_account "$name"
  if [[ "$which" == "claude" || "$which" == "all" ]]; then
    say "── Claude Code girişi ($name). Tarayıcıda DOĞRU hesabı/organizasyonu seç."
    ( apply_env; claude auth login ) || warn "Claude Code girişi tamamlanmadı"
  fi
  if [[ "$which" == "hermes" || "$which" == "all" ]]; then
    if is_default; then
      say "── Hermes (default) ~/.claude girişini ödünç alıyor; ayrı giriş gerekmiyor."
    else
      say "── Hermes girişi ($name). Tarayıcıda yine $name hesabını seç, çıkan kodu buraya yapıştır."
      hermes -p "$ACC_PROFILE" auth add anthropic --type oauth --label "ccs-$name" \
        || warn "Hermes girişi tamamlanmadı"
    fi
  fi
  say ""
  cmd_status "$name"
}

# Prints who each side of an account is logged in as. Secrets never printed.
cmd_status() {
  ensure_registry
  local names=()
  if [[ $# -gt 0 ]]; then names=("$@"); else while IFS=$'\t' read -r n _; do names+=("$n"); done < "$REG"; fi
  for n in "${names[@]}"; do
    need_account "$n"
    local cc_json phome
    cc_json="$( ( apply_env; claude auth status 2>/dev/null ) || true )"
    phome="$(profile_home)"
    "$PY" - "$ACC_NAME" "$ACC_DIR" "$phome" "$ACC_PROFILE" "$cc_json" <<'PY'
import json, sys, time, re, pathlib, urllib.request
name, cdir, phome, profile, cc_raw = sys.argv[1:6]
home = pathlib.Path(phome)
print(f"● {name}")

def who(token):
    """Ask Anthropic which account an OAuth access token belongs to."""
    try:
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/profile", headers={
            "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20",
            "Content-Type": "application/json"})
        d = json.load(urllib.request.urlopen(req, timeout=10))
        a, o = d.get("account") or {}, d.get("organization") or {}
        return f"{a.get('email_address') or a.get('display_name') or '?'} · {o.get('name','?')} · {o.get('organization_type','?')} ({o.get('rate_limit_tier','')})"
    except Exception as e:
        return f"kimlik sorgulanamadı ({type(e).__name__})"

# Claude Code side
try:
    cc = json.loads(cc_raw) if cc_raw.strip() else {}
except ValueError:
    cc = {}
if cc.get("loggedIn"):
    bits = [cc.get("email"), cc.get("orgName"), cc.get("subscriptionType")]
    print(f"  Claude Code : {' · '.join(str(b) for b in bits if b) or 'giriş var'}   [{cdir}]")
else:
    print(f"  Claude Code : giriş YOK  →  ccs login {name} claude   [{cdir}]")

# Hermes side
if not home.exists():
    print(f"  Hermes      : profil yok  →  ccs add {name}")
    sys.exit(0)
cfg = (home / "config.yaml").read_text() if (home / "config.yaml").exists() else ""
m = re.search(r"^\s*adopt_external_logins:\s*(\S+)", cfg, re.M)
adopt = not (m and m.group(1).lower() in ("false", "no", "off"))
try:
    rows = json.loads((home / "auth.json").read_text()).get("credential_pool", {}).get("anthropic", [])
except Exception:
    rows = []
own = [r for r in rows if r.get("source") != "claude_code"]
label = f"profil {profile}"
if profile == "default":
    if any(r.get("source") == "claude_code" for r in rows) and adopt:
        # Hermes reads the same login from <cdir>/.credentials.json (or the Keychain).
        ident = "ödünç giriş"
        try:
            c = json.loads((pathlib.Path(cdir) / ".credentials.json").read_text())["claudeAiOauth"]
            if c.get("expiresAt", 0) > time.time() * 1000 + 60_000:
                ident = who(c["accessToken"])
            else:
                ident = "ödünç giriş; token süresi dolmuş, ilk kullanımda yenilenir"
        except Exception:
            pass
        print(f"  Hermes      : {ident} — ~/.claude girişini ödünç alıyor   [{label}]")
    elif own:
        print(f"  Hermes      : kendi girişi ({own[0].get('label')})   [{label}]")
    else:
        print(f"  Hermes      : Anthropic girişi yok   [{label}]")
    sys.exit(0)
if not own:
    print(f"  Hermes      : kendi girişi YOK → açılmaz (yoksa varsayılan hesaba düşerdi)  →  ccs login {name} hermes   [{label}]")
    sys.exit(0)
r = own[0]
tok, exp = r.get("access_token") or "", r.get("expires_at_ms") or 0
if tok and (not exp or exp > time.time() * 1000 + 60_000):
    ident = who(tok)
else:
    ident = "token süresi dolmuş; ilk kullanımda yenilenir"
flag = "" if not adopt else "  ⚠ adopt_external_logins açık"
print(f"  Hermes      : {ident}   [{label}]{flag}")
PY
  done
}

cmd_run() {
  local name="${1:-}"; shift || true
  [[ -n "$name" && $# -gt 0 ]] || die "kullanım: ccs run <ad> <komut> [arg…]"
  ensure_registry; need_account "$name"
  apply_env
  if [[ "$(basename "$1")" == "hermes" ]]; then
    hermes_guard
  fi
  exec "$@"
}

# Printed for `eval` by the shell function from `ccs shell-init`.
cmd_env() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "kullanım: ccs env <ad>"
  ensure_registry; need_account "$name"
  if is_default; then
    printf 'unset CLAUDE_CONFIG_DIR HERMES_HOME; export CCS_ACCOUNT=%q\n' "$ACC_NAME"
  else
    hermes_guard
    printf 'export CLAUDE_CONFIG_DIR=%q HERMES_HOME=%q CCS_ACCOUNT=%q\n' "$ACC_DIR" "$(profile_home)" "$ACC_NAME"
  fi
}

cmd_shell_init() {
  cat <<'SH'
# ccs: `ccs use <ad>` bu terminaldeki claude + hermes hesabını değiştirir.
ccs() {
  if [ "$1" = "use" ]; then
    [ -n "$2" ] || { echo "kullanım: ccs use <ad>" >&2; return 1; }
    local _ccs_env; _ccs_env="$(command ccs env "$2")" || return 1
    eval "$_ccs_env" && echo "ccs: bu terminal artık '$2' hesabında (claude + hermes)"
  else
    command ccs "$@"
  fi
}
SH
}

cmd_list() {
  ensure_registry
  local cur="${CCS_ACCOUNT:-}"
  while IFS=$'\t' read -r n d p; do
    local mark=" "; [[ "$n" == "$cur" ]] && mark="*"
    printf '%s %-10s claude: %-28s hermes profili: %s\n' "$mark" "$n" "${d/#$HOME/~}" "$p"
  done < "$REG"
}

cmd_whoami() {
  ensure_registry
  local n="${CCS_ACCOUNT:-}"
  if [[ -z "$n" ]]; then
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then n="$(awk -F'\t' -v d="$CLAUDE_CONFIG_DIR" '$2==d{print $1}' "$REG")"; fi
    n="${n:-$(awk -F'\t' '$3=="default"{print $1; exit}' "$REG")}"
  fi
  cmd_status "$n"
}

cmd_init() {
  local name="${1:-}"
  valid_name "$name"
  ensure_registry
  lookup "$name" && ! is_default && die "'$name' zaten başka bir hesap"
  awk -F'\t' -v OFS='\t' -v n="$name" '$3=="default"{$1=n} {print}' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
  say "✓ varsayılan hesabın (~/.claude + default Hermes) adı: $name"
}

cmd_remove() {
  local name="${1:-}" purge="${2:-}"
  [[ -n "$name" ]] || die "kullanım: ccs remove <ad> [--purge]"
  ensure_registry; need_account "$name"
  is_default && die "varsayılan hesap silinemez"
  rm -f "$BIN_DIR/claude-$name" "$BIN_DIR/hermes-$name"
  awk -F'\t' -v n="$name" '$1!=n' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
  say "✓ $name kayıttan ve komutlardan çıkarıldı"
  if [[ "$purge" == "--purge" ]]; then
    # Unlink shared items first so deleting the profile can never touch the originals.
    local phome; phome="$(profile_home)"
    for item in "${SHARED_HERMES_ITEMS[@]}"; do [[ -L "$phome/$item" ]] && rm "$phome/$item"; done
    hermes profile delete "$ACC_PROFILE" || warn "Hermes profili silinemedi"
    find "$ACC_DIR" -maxdepth 1 -type l -delete 2>/dev/null || true
    rm -rf "$ACC_DIR"
    say "✓ $ACC_DIR ve Hermes profili silindi (Keychain kaydı: Claude Code'da /logout ile temizlenir)"
  else
    say "  veriler duruyor: $ACC_DIR, $(profile_home)  (silmek için: ccs remove $name --purge)"
  fi
}

usage() {
  cat <<EOF
ccs $VERSION — Claude Code ve Hermes'i birden çok Claude hesabıyla yan yana çalıştır.

  ccs init <ad>              mevcut kurulumun (~/.claude + default Hermes) adı, örn. max
  ccs add <ad> [--isolated]  yeni hesap: ~/.claude-<ad>, Hermes profili <ad>, claude-<ad>/hermes-<ad>
  ccs login <ad> [claude|hermes|all]   tarayıcıda giriş (Claude Code ve Hermes ayrı ayrı)
  ccs status [ad…]           her hesap gerçekte hangi Claude hesabına bağlı (Anthropic'e sorar)
  ccs whoami                 bu terminal hangi hesapta
  ccs list                   kayıtlı hesaplar (* = bu terminal)
  ccs run <ad> <komut…>      tek komutu o hesapla çalıştır (ccs run team claude -c)
  ccs use <ad>               bu terminali o hesaba geçir (shell-init gerekir)
  ccs env <ad>               use'un bastığı export satırları
  ccs shell-init             .zshrc için:  eval "\$(ccs shell-init)"
  ccs remove <ad> [--purge]  hesabı kaldır

Örnek:  claude-team  |  hermes-team  |  ccs use team && hermes
EOF
}

main() {
  ensure_registry
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    login) cmd_login "$@" ;;
    status) cmd_status "$@" ;;
    whoami) cmd_whoami ;;
    list|ls) cmd_list ;;
    run) cmd_run "$@" ;;
    env) cmd_env "$@" ;;
    use) die "'use' shell fonksiyonu ister: .zshrc'ye  eval \"\$(ccs shell-init)\"  ekle ya da: eval \"\$(ccs env ${1:-<ad>})\"" ;;
    shell-init) cmd_shell_init ;;
    remove|rm) cmd_remove "$@" ;;
    -v|--version|version) say "ccs $VERSION" ;;
    help|-h|--help) usage ;;
    *) die "bilinmeyen komut: $cmd  (ccs help)" ;;
  esac
}

main "$@"
