SHELL_INIT = r'''
# seat — Claude seat per terminal / project. https://github.com/tolgazorlu/claude-seat-switcher
# SEAT_ASK=0: no menu at launch · SEAT_PROMPT=0: no prompt tag
_seat_interactive() {   # $1 tool, rest args → 0 if this is an interactive session launch
  local tool="$1"; shift
  [ -t 0 ] && [ -t 1 ] || return 1
  local a; for a in "$@"; do
    case "$a" in -h|--help|--version|-V) return 1 ;; esac
    if [ "$tool" = hermes ]; then case "$a" in -p|--profile|--profile=*|-z|--oneshot|-Q|--quiet) return 1 ;; esac
    else case "$a" in -p|--print|-v) return 1 ;; esac; fi
  done
  [ $# -eq 0 ] && return 0
  case "$tool:$1" in
    hermes:chat|hermes:-*) return 0 ;;
    hermes:*) return 1 ;;
    claude:auth|claude:mcp|claude:update|claude:upgrade|claude:doctor|claude:install|claude:setup-token|claude:plugin|claude:plugins|claude:config|claude:migrate-installer|claude:agents) return 1 ;;
  esac
  return 0
}
_seat_run() {
  local tool="$1"; shift
  if ! _seat_interactive "$tool" "$@"; then command "$tool" "$@"; return; fi
  local _e _t _rc _n
  if [ "${SEAT_ASK:-1}" != 0 ]; then
    _e="$(command seat _launch "$tool")" || return 1
    eval "$_e"
  fi
  if [ "$tool" = hermes ]; then command seat _guard || return 1; fi
  while :; do
    _t=$(date +%s)
    command "$tool" "$@"; _rc=$?
    _n="$(command seat _after "$tool" "$_t")" || break
    [ -n "$_n" ] || break
    eval "$_n"
  done
  return $_rc
}
hermes() { _seat_run hermes "$@"; }
claude() { _seat_run claude "$@"; }
seat() {
  if [ "$1" = use ]; then
    local _e; _e="$(command seat env "${2:?kullanım: seat use <ad>}")" || return 1
    eval "$_e" && echo "seat ▸ bu terminal artık '$2' hesabında (claude + hermes)"
  else command seat "$@"; fi
}
_seat_cd() { local _e; _e="$(command seat _cd 2>/dev/null)" && [ -n "$_e" ] && eval "$_e"; }
if [ -n "$ZSH_VERSION" ]; then
  autoload -Uz add-zsh-hook && add-zsh-hook chpwd _seat_cd
  if [ "${SEAT_PROMPT:-1}" = 1 ]; then
    setopt prompt_subst
    case "$RPROMPT" in *SEAT_ACCOUNT*) ;; *) RPROMPT='%F{8}${SEAT_ACCOUNT:+⌁ $SEAT_ACCOUNT}%f'"$RPROMPT" ;; esac
  fi
fi
_seat_cd
'''


