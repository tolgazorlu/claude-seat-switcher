#!/usr/bin/env python3
"""seat — pick which Claude account (seat) Claude Code and Hermes use, per terminal
and per project, with live limit bars and an offer to continue on another seat when
one hits its limit.

stdlib only, Python 3.9+ (macOS system python). Secrets are never printed: tokens are
read only to ask api.anthropic.com about usage/identity, and are never refreshed here
(refresh tokens are single-use; refreshing behind Claude Code's back would log it out).

Ideas (no code) borrowed from: uwuclxdy/clauth (MIT) usage bars + fallback chain,
Nemo-Illusionist/claude-code-account-switcher (MIT) directory binding,
inulute/cux (GPL-3.0) per-project seat pools and resume-after-switch.
"""
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import threading
import time
import urllib.request
from datetime import datetime
from pathlib import Path

VERSION = "0.3.0"
HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("SEAT_CONFIG_DIR", HOME / ".config" / "seat"))
CONFIG = CONFIG_DIR / "config.json"
CACHE_DIR = Path(os.environ.get("SEAT_CACHE_DIR", HOME / ".cache" / "seat"))
HERMES_ROOT = Path(os.environ.get("SEAT_HERMES_ROOT", HOME / ".hermes"))
DEFAULT_CLAUDE_DIR = HOME / ".claude"
LEGACY_TSV = HOME / ".config" / "ccs" / "accounts.tsv"
OFFLINE = os.environ.get("SEAT_OFFLINE") == "1"   # tests: never touch the network
SHARED_CLAUDE_ITEMS = ["CLAUDE.md", "settings.json", "commands", "agents", "skills", "hooks", "plugins", "output-styles"]
PERSONAL_DOMAINS = {"gmail.com", "googlemail.com", "icloud.com", "me.com", "outlook.com", "hotmail.com",
                    "live.com", "yahoo.com", "proton.me", "protonmail.com", "yandex.com"}
LIMIT_PCT = 99.0     # at/above: treated as limited
WARN_PCT = 90.0      # at/above: warn on launch
USAGE_TTL = 90       # seconds a cached usage reading is considered fresh
LIMIT_TEXT = re.compile(r"usage limit|hit your limit|rate[ _-]?limit|limit reached", re.I)


# ── small utils ──────────────────────────────────────────────────────────────
def die(msg, code=1):
    sys.stderr.write(f"seat: {msg}\n")
    sys.exit(code)


def tty_write(text):
    """Write to the controlling terminal (stdout may be captured by the shell)."""
    try:
        with open("/dev/tty", "w") as t:
            t.write(text)
    except OSError:
        sys.stderr.write(text)


def color(s, code):
    return s if os.environ.get("NO_COLOR") else f"\033[{code}m{s}\033[0m"


def write_private(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w") as f:
        f.write(data)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def now():
    return time.time()


def slug(path):
    """Claude Code's per-project folder name under <config>/projects/."""
    return re.sub(r"[^a-zA-Z0-9]", "-", str(path))


def group_for(email):
    domain = (email or "").rsplit("@", 1)[-1].lower()
    if not domain or domain in PERSONAL_DOMAINS:
        return "personal"
    return re.sub(r"[^a-z0-9]", "", domain.split(".")[0]) or "work"


def fmt_reset(epoch):
    if not epoch:
        return ""
    left = epoch - now()
    if left <= 0:
        return "şimdi"
    h, m = int(left // 3600), int(left % 3600 // 60)
    when = datetime.fromtimestamp(epoch).strftime("%H:%M" if left < 86400 else "%d.%m %H:%M")
    return f"{when} ({h}s {m}dk)" if h else f"{when} ({m}dk)"


def bar(pct, width=8):
    if pct is None:
        return color("·" * width, "2") + "   ?"
    filled = max(0, min(width, int(round(pct / 100 * width))))
    code = "32" if pct < 70 else ("33" if pct < WARN_PCT else "31")
    return color("█" * filled, code) + color("░" * (width - filled), "2") + f" {pct:3.0f}%"


# ── config ───────────────────────────────────────────────────────────────────
class Account:
    def __init__(self, d):
        self.name = d["name"]
        self.email = d.get("email", "")
        self.group = d.get("group") or group_for(self.email)
        self.claude_dir = Path(os.path.expanduser(d["claude_dir"]))
        self.hermes_profile = d.get("hermes_profile", self.name)
        self.isolated = bool(d.get("isolated", False))

    def to_dict(self):
        return {"name": self.name, "email": self.email, "group": self.group,
                "claude_dir": str(self.claude_dir).replace(str(HOME), "~", 1),
                "hermes_profile": self.hermes_profile, "isolated": self.isolated}

    @property
    def is_default(self):
        return self.hermes_profile == "default"

    @property
    def hermes_home(self):
        return HERMES_ROOT if self.is_default else HERMES_ROOT / "profiles" / self.hermes_profile

    def env(self):
        """Environment for this seat. Default seat: CLAUDE_CONFIG_DIR must stay UNSET —
        Claude Code keys its Keychain item on it, so even ~/.claude would log it out."""
        if self.is_default:
            return {"SEAT_ACCOUNT": self.name, "CLAUDE_CONFIG_DIR": None, "HERMES_HOME": None}
        return {"SEAT_ACCOUNT": self.name, "CLAUDE_CONFIG_DIR": str(self.claude_dir),
                "HERMES_HOME": str(self.hermes_home)}

    def env_script(self):
        parts, unset = [], []
        for k, v in self.env().items():
            if v is None:
                unset.append(k)
            else:
                parts.append(f"{k}={shlex.quote(v)}")
        out = []
        if unset:
            out.append("unset " + " ".join(unset))
        out.append("export " + " ".join(parts))
        return "; ".join(out)

    def proc_env(self):
        e = dict(os.environ)
        for k, v in self.env().items():
            if v is None:
                e.pop(k, None)
            else:
                e[k] = v
        return e

    def label(self):
        return f"{self.name} <{self.email}>" if self.email else self.name


class Config:
    def __init__(self):
        data = read_json(CONFIG)
        if data is None:
            data = self._bootstrap()
        self.accounts = [Account(a) for a in data.get("accounts", [])]
        self.projects = data.get("projects", [])
        self.settings = data.get("settings", {})

    @staticmethod
    def _bootstrap():
        accounts = []
        if LEGACY_TSV.exists():   # migrate from ccs v0.2
            for line in LEGACY_TSV.read_text().splitlines():
                cols = (line.split("\t") + ["", "", "", ""])[:4]
                if cols[0]:
                    accounts.append({"name": cols[0], "claude_dir": cols[1], "hermes_profile": cols[2],
                                     "email": cols[3], "group": group_for(cols[3])})
        if not any(a["hermes_profile"] == "default" for a in accounts):
            accounts.insert(0, {"name": "default", "claude_dir": "~/.claude", "hermes_profile": "default",
                                "email": "", "group": "personal"})
        data = {"version": 1, "accounts": accounts, "projects": [], "settings": {}}
        write_private(CONFIG, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        return data

    def save(self):
        data = {"version": 1, "accounts": [a.to_dict() for a in self.accounts],
                "projects": self.projects, "settings": self.settings}
        write_private(CONFIG, json.dumps(data, indent=2, ensure_ascii=False) + "\n")

    def get(self, name):
        for a in self.accounts:
            if a.name == name:
                return a
        return None

    def need(self, name):
        a = self.get(name)
        if not a:
            die(f"'{name}' diye bir hesap yok. Kayıtlı: {', '.join(x.name for x in self.accounts)}")
        return a

    @property
    def default(self):
        return next(a for a in self.accounts if a.is_default)

    def current(self):
        name = os.environ.get("SEAT_ACCOUNT") or os.environ.get("CCS_ACCOUNT")
        if name and self.get(name):
            return self.get(name)
        cfg = os.environ.get("CLAUDE_CONFIG_DIR")
        if cfg:
            for a in self.accounts:
                if not a.is_default and str(a.claude_dir) == str(Path(cfg).expanduser()):
                    return a
        return self.default

    def rule_for(self, cwd):
        """Longest path-boundary match among project rules, or None."""
        cwd = str(Path(cwd).resolve())
        best = None
        for r in self.projects:
            p = r["path"].rstrip("/")
            if cwd == p or cwd.startswith(p + "/"):
                if best is None or len(p) > len(best["path"]):
                    best = r
        return best

    def allowed(self, cwd, current):
        """Seats a terminal in *cwd* may use automatically: the project's list, else the
        current seat's group (a personal project never spills onto a company seat)."""
        rule = self.rule_for(cwd)
        if rule:
            return [a for a in (self.get(n) for n in rule["accounts"]) if a]
        return [a for a in self.accounts if a.group == current.group]


# ── login state (cheap, local) ───────────────────────────────────────────────
def hermes_rows(acc):
    data = read_json(acc.hermes_home / "auth.json", {}) or {}
    return (data.get("credential_pool") or {}).get("anthropic") or []


def hermes_adopts(acc):
    try:
        cfg = (acc.hermes_home / "config.yaml").read_text()
    except OSError:
        return True
    m = re.search(r"^\s*adopt_external_logins:\s*(\S+)", cfg, re.M)
    return not (m and m.group(1).lower() in ("false", "no", "off"))


def hermes_ready(acc):
    """True if Hermes on this seat would use this seat's own login. A non-default profile
    with no Anthropic rows reads the root pool = the default seat's limits."""
    rows = hermes_rows(acc)
    if acc.is_default:
        return bool(rows) or (DEFAULT_CLAUDE_DIR / ".credentials.json").exists()
    return (not hermes_adopts(acc)) and any(r.get("source") != "claude_code" for r in rows)


def claude_ready(acc):
    data = read_json(acc.claude_dir / ".claude.json" if not acc.is_default else HOME / ".claude.json", {}) or {}
    return bool((data.get("oauthAccount") or {}).get("emailAddress"))


def ready(acc, tool):
    return hermes_ready(acc) if tool == "hermes" else claude_ready(acc)


def claude_auth_status(acc):
    try:
        out = subprocess.run(["claude", "auth", "status"], env=acc.proc_env(), capture_output=True,
                             text=True, timeout=20).stdout
        return json.loads(out)
    except Exception:
        return {}


# ── tokens + Anthropic API (read-only, never refreshed) ──────────────────────
def valid_tokens(acc):
    toks = []
    for r in hermes_rows(acc):
        if r.get("source") != "claude_code" and r.get("access_token") and \
                (r.get("expires_at_ms") or 0) > now() * 1000 + 60_000:
            toks.append(r["access_token"])
    cred = read_json(acc.claude_dir / ".credentials.json", {}) or {}
    c = cred.get("claudeAiOauth") or {}
    if c.get("accessToken") and c.get("expiresAt", 0) > now() * 1000 + 60_000:
        toks.append(c["accessToken"])
    return toks


def api_get(path, token, timeout=4.0):
    req = urllib.request.Request("https://api.anthropic.com" + path, headers={
        "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20",
        "Content-Type": "application/json", "User-Agent": f"seat/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def identity(acc, token=None):
    if OFFLINE:
        return None
    for tok in ([token] if token else valid_tokens(acc)):
        try:
            d = api_get("/api/oauth/profile", tok)
            return {"email": (d.get("account") or {}).get("email"),
                    "org": (d.get("organization") or {}).get("name"),
                    "type": (d.get("organization") or {}).get("organization_type")}
        except Exception:
            continue
    return None


def _iso(ts):
    try:
        return datetime.fromisoformat(ts).timestamp() if ts else None
    except ValueError:
        return None


def cache_path(acc):
    return CACHE_DIR / "usage" / f"{acc.name}.json"


def cache_read(acc):
    return read_json(cache_path(acc))


def cache_write(acc, usage):
    write_private(cache_path(acc), json.dumps(usage))


def fetch_usage(acc):
    """Live usage from Anthropic, or None. {'five_hour': {'pct', 'resets'}, 'seven_day': …}"""
    if OFFLINE:
        return None
    for tok in valid_tokens(acc):
        try:
            d = api_get("/api/oauth/usage", tok, timeout=3.0)
        except Exception:
            continue
        u = {"ts": now(), "src": "api"}
        for k in ("five_hour", "seven_day"):
            w = d.get(k) or {}
            if w.get("utilization") is not None:
                u[k] = {"pct": float(w["utilization"]), "resets": _iso(w.get("resets_at"))}
        cache_write(acc, u)
        return u
    return None


def usage_for(accounts, fresh=False, max_age=USAGE_TTL):
    """Usage per seat name: fresh cache, else a parallel live fetch (≈3s cap), else stale cache."""
    out, todo = {}, []
    for a in accounts:
        c = cache_read(a)
        if c and not fresh and now() - c.get("ts", 0) < max_age:
            out[a.name] = c
        else:
            out[a.name] = c
            todo.append(a)

    def work(a):
        u = fetch_usage(a)
        if u:
            out[a.name] = u
    threads = [threading.Thread(target=work, args=(a,), daemon=True) for a in todo]
    for t in threads:
        t.start()
    for t in threads:
        t.join(3.5)
    return out


def window(u, k):
    w = (u or {}).get(k) or {}
    if w.get("resets") and w["resets"] < now():   # window rolled over since the reading
        return None, None
    return w.get("pct"), w.get("resets")


def is_limited(u):
    return any((window(u, k)[0] or 0) >= LIMIT_PCT for k in ("five_hour", "seven_day"))


def usage_line(u):
    p5, r5 = window(u, "five_hour")
    p7, _ = window(u, "seven_day")
    age = ""
    if u and now() - u.get("ts", 0) > 600:
        age = color(f"  ({int((now() - u['ts']) // 60)}dk önce)", "2")
    s = f"5s {bar(p5)}  7g {bar(p7)}"
    if p5 is not None and p5 >= WARN_PCT and r5:
        s += color(f"  ↻ {fmt_reset(r5)}", "2")
    return s + age


def limit_summary(u):
    bits = []
    for k, lab in (("five_hour", "5s"), ("seven_day", "7g")):
        p, r = window(u, k)
        if p is not None and p >= LIMIT_PCT:
            bits.append(f"{lab} %{p:.0f}, açılış {fmt_reset(r)}")
    return "; ".join(bits)


# ── interactive picker (arrow keys, digits, Enter, q) ────────────────────────
def pick(title, accounts, tool, default=None, usages=None):
    """Returns the chosen Account or None (cancelled)."""
    import termios
    import tty as ttymod
    usages = usages or {}
    width = max(len(a.name) for a in accounts)
    ewidth = max(len(a.email or "?") for a in accounts)
    usable = [ready(a, tool) for a in accounts]
    idx = next((i for i, a in enumerate(accounts) if default and a.name == default.name and usable[i]),
               next((i for i, ok in enumerate(usable) if ok), 0))

    def render(first):
        lines = [color(title, "1")]
        for i, a in enumerate(accounts):
            cur = "❯" if i == idx else " "
            name = a.name.ljust(width)
            meta = f"{(a.email or '?').ljust(ewidth)}  {color(a.group.ljust(9), '2')}"
            if usable[i]:
                info = usage_line(usages.get(a.name))
                row = f" {cur} {i + 1}) {name}  {meta} {info}"
                lines.append(color(row, "1") if i == idx else row)
            else:
                lines.append(color(f" {cur} {i + 1}) {name}  {a.email or '?'}  giriş yok → seat login {a.name}", "2"))
        lines.append(color("   ↑↓ seç · Enter onayla · q vazgeç", "2"))
        out = "" if first else f"\033[{len(lines)}A"
        return out + "".join(f"\r\033[2K{line}\n" for line in lines)

    with open("/dev/tty", "r+b", buffering=0) as t:
        fd = t.fileno()
        old = termios.tcgetattr(fd)
        t.write(b"\033[?25l")
        t.write(render(True).encode())
        try:
            ttymod.setcbreak(fd)
            while True:
                ch = os.read(fd, 3)
                if ch in (b"\r", b"\n"):
                    if usable[idx]:
                        return accounts[idx]
                elif ch in (b"q", b"\x1b", b"\x03"):
                    return None
                elif ch in (b"\x1b[A", b"k"):
                    idx = (idx - 1) % len(accounts)
                elif ch in (b"\x1b[B", b"j"):
                    idx = (idx + 1) % len(accounts)
                elif ch.isdigit() and 1 <= int(ch) <= len(accounts):
                    idx = int(ch) - 1
                    if usable[idx]:
                        t.write(render(False).encode())
                        return accounts[idx]
                t.write(render(False).encode())
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
            t.write(b"\033[?25h")


def confirm(question, default_yes=True):
    # Separate read/write handles: a text-mode "r+" on a tty is not seekable and fails.
    try:
        with open("/dev/tty", "w") as out, open("/dev/tty") as inp:
            out.write(question + (" [E/h] " if default_yes else " [e/H] "))
            out.flush()
            ans = inp.readline().strip().lower()
    except OSError:
        return False
    return default_yes if not ans else ans in ("e", "evet", "y", "yes")


def announce(acc, u, why=""):
    p5, r5 = window(u, "five_hour")
    p7, _ = window(u, "seven_day")
    us = ""
    if p5 is not None or p7 is not None:
        us = " · " + " · ".join(x for x in (f"5s %{p5:.0f}" if p5 is not None else "",
                                           f"7g %{p7:.0f}" if p7 is not None else "") if x)
    line = color("seat ▸ ", "2") + color(acc.name, "1") + f" · {acc.email or '?'}{us}" + (color(f"  ({why})", "2") if why else "")
    tty_write(line + "\n")
    if p5 is not None and p5 >= WARN_PCT and p5 < LIMIT_PCT:
        tty_write(color(f"       5 saatlik limit %{p5:.0f}, {fmt_reset(r5)} açılır\n", "33"))


# ── shell hooks: launch / after / cd ─────────────────────────────────────────
def cmd_launch(cfg, args):
    """Print an env script choosing the seat for an interactive hermes/claude launch."""
    tool = args[0] if args else "claude"
    cwd = os.getcwd()
    cur = cfg.current()
    rule = cfg.rule_for(cwd)
    if rule:
        allowed = cfg.allowed(cwd, cur)
        usages = usage_for(allowed)
        good = [a for a in allowed if ready(a, tool) and not is_limited(usages.get(a.name))]
        choice = cur if cur in good else (good[0] if good else None)
        if choice and (choice is cur or len(good) == 1 or cur not in allowed):
            announce(choice, usages.get(choice.name), f"proje: {rule['path'].replace(str(HOME), '~', 1)}")
            print(choice.env_script())
            return
        acc = pick(f"Bu proje için Claude hesabı ({tool}):", allowed, tool, cur, usages)
    else:
        usages = usage_for(cfg.accounts)
        acc = pick(f"Claude hesabı ({tool}):", cfg.accounts, tool, cur, usages)
    if acc is None:
        sys.exit(1)
    announce(acc, usages.get(acc.name))
    if is_limited(usages.get(acc.name)):
        tty_write(color(f"       ⚠ bu hesap limitte: {limit_summary(usages.get(acc.name))}\n", "31"))
    print(acc.env_script())


def last_claude_session(acc, cwd, since):
    folder = acc.claude_dir / "projects" / slug(cwd)
    files = [p for p in folder.glob("*.jsonl") if p.stat().st_mtime >= since] if folder.is_dir() else []
    return max(files, key=lambda p: p.stat().st_mtime) if files else None


def transcript_hit_limit(path, since=None):
    """Did this run end on an API limit error? Looks at the last 40 entries; errors stamped
    before *since* belong to an earlier run (e.g. a transcript carried over from another seat)."""
    try:
        lines = path.read_text(errors="replace").splitlines()[-40:]
    except OSError:
        return False
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "user" and not e.get("isMeta"):
            return False   # the user kept going after any error
        if e.get("isApiErrorMessage") or e.get("error"):
            ts = _iso((e.get("timestamp") or "").replace("Z", "+00:00"))
            if since and ts and ts <= since:   # a fresh error cannot land in the launch second
                return False
            content = (e.get("message") or {}).get("content") or []
            text = " ".join(c.get("text", "") for c in content if isinstance(c, dict)) + " " + json.dumps(e.get("error") or "")
            if LIMIT_TEXT.search(text):
                return True
    return False


def last_hermes_session(acc, since):
    db = acc.hermes_home / "state.db"
    if not db.exists():
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
        row = con.execute("select id from sessions where started_at >= ? and source in ('cli','tui') "
                          "order by started_at desc limit 1", (since - 5,)).fetchone()
        con.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None


def carry_claude_session(src, dst, cwd, session):
    """Copy a Claude Code transcript (and its sidecar folder) into another seat's config
    dir so `claude --resume <id>` finds it there."""
    sid = session.stem
    target = dst.claude_dir / "projects" / slug(cwd)
    target.mkdir(parents=True, exist_ok=True)
    shutil.copy2(session, target / session.name)
    side = session.with_suffix("")
    if side.is_dir():
        shutil.copytree(side, target / sid, dirs_exist_ok=True)
    return sid


def hermes_handoff(src, sid):
    """Export the Hermes session as markdown and build a seed prompt for the new seat."""
    out = CACHE_DIR / "handoff" / time.strftime("%Y%m%d-%H%M%S")
    out.mkdir(parents=True, exist_ok=True)
    for d in (CACHE_DIR, out.parent, out):   # transcripts are private
        os.chmod(d, 0o700)
    subprocess.run(["hermes", "sessions", "export", "--format", "md", "--session-id", sid, str(out) + "/"],
                   env=src.proc_env(), capture_output=True, timeout=60)
    files = sorted(out.glob("*.md"))
    if not files:
        return None
    return (f"Önceki Hermes oturumu ({src.name} hesabı) Claude limiti dolduğu için yarıda kaldı. "
            f"Transkript: {files[0]} — önce onu oku, sonra kaldığın yerden devam et; "
            f"ne yaptığını ve sıradaki adımı kısaca özetleyerek başla.")


def cmd_after(cfg, args):
    """Run after hermes/claude exits. If the seat is out of limits, offer another allowed
    seat; prints an env script + `set -- …` for the shell loop, or nothing."""
    tool, since = args[0], float(args[1])
    cwd = os.getcwd()
    cur = cfg.current()
    session = last_claude_session(cur, cwd, since) if tool == "claude" else None
    flagged = bool(session and transcript_hit_limit(session, since))
    cached = cache_read(cur)
    if tool == "claude" and not flagged:
        # The status line refreshed the cache during the session; no network needed.
        u = cached if (cached and cached.get("ts", 0) >= since) else None
    else:
        u = usage_for([cur], fresh=True).get(cur.name)
    if not (flagged or is_limited(u)):
        return
    reason = limit_summary(u) or "limit hatası"
    cands = [a for a in cfg.allowed(cwd, cur) if a.name != cur.name and ready(a, tool)]
    usages = usage_for(cands)
    cands = sorted([a for a in cands if not is_limited(usages.get(a.name))],
                   key=lambda a: (window(usages.get(a.name), "five_hour")[0] or 0))
    tty_write("\n" + color(f"⚠ {cur.name} limiti doldu ({reason}).", "33") + "\n")
    if not cands:
        rule = cfg.rule_for(cwd)
        scope = "bu proje" if rule else f"'{cur.group}' grubu"
        tty_write(f"  {scope} için geçilebilecek başka hesap yok. Proje kuralı: seat bind <hesap,...>\n")
        return
    if len(cands) == 1:
        target = cands[0]
        p5 = window(usages.get(target.name), "five_hour")[0]
        extra = f" · 5s %{p5:.0f}" if p5 is not None else ""
        if not confirm(f"  → {target.name} ({target.email}{extra}) hesabına geçip devam edilsin mi?"):
            return
    else:
        target = pick("Hangi hesapla devam edilsin?", cands, tool, cands[0], usages)
        if target is None:
            return
    script = [target.env_script()]
    if tool == "claude":
        if session:
            sid = carry_claude_session(cur, target, cwd, session)
            script.append(f"set -- --resume {shlex.quote(sid)}")
        else:
            script.append("set --")
    else:
        sid = last_hermes_session(cur, since)
        seed = hermes_handoff(cur, sid) if sid else None
        script.append(f"set -- chat -q {shlex.quote(seed)}" if seed else "set --")
    announce(target, usages.get(target.name), f"{cur.name} limitte")
    print("; ".join(script))


def cmd_cd(cfg, args):
