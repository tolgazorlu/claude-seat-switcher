def cmd_remove(cfg, args):
    if not args:
        die("kullanım: seat remove <ad> [--purge]")
    acc = cfg.need(args[0])
    if acc.is_default:
        die("varsayılan hesap silinemez")
    cfg.accounts = [a for a in cfg.accounts if a.name != acc.name]
    for r in cfg.projects:
        r["accounts"] = [n for n in r["accounts"] if n != acc.name]
    cfg.projects = [r for r in cfg.projects if r["accounts"]]
    cfg.save()
    if "--purge" in args:
        for item in ("skills", "memories"):
            p = acc.hermes_home / item
            if p.is_symlink():
                p.unlink()
        if acc.hermes_home.exists():
            subprocess.run(["hermes", "profile", "delete", acc.hermes_profile, "--yes"], capture_output=True)
        if acc.claude_dir.exists():
            subprocess.run(["claude", "auth", "logout"], env=acc.proc_env(), capture_output=True)
            for p in acc.claude_dir.iterdir():
                if p.is_symlink():
                    p.unlink()
            shutil.rmtree(acc.claude_dir, ignore_errors=True)
        try:
            cache_path(acc).unlink()
        except OSError:
            pass
        print(f"✓ {acc.name} tamamen silindi")
    else:
        print(f"✓ {acc.name} listeden çıkarıldı (veri duruyor; tamamen silmek için --purge)")


