def cmd_statusline(cfg, args):
    """`statusLine` command for Claude Code: records rate_limits per seat and prints a
    compact indicator. Must be fast and must never fail loudly."""
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    acc = cfg.current()
    rl = data.get("rate_limits") or {}
    if rl:
        u = {"ts": now(), "src": "statusline"}
        for k in ("five_hour", "seven_day"):
            w = rl.get(k) or {}
            if w.get("used_percentage") is not None:
                u[k] = {"pct": float(w["used_percentage"]), "resets": w.get("resets_at")}
        try:
            cache_write(acc, u)
        except OSError:
            pass
    else:
        u = cache_read(acc)
    model = ((data.get("model") or {}).get("display_name")) or ""
    parts = [color(acc.name, "1")]
    if model:
        parts.append(model)
    for k, lab in (("five_hour", "5s"), ("seven_day", "7g")):
        p, r = window(u, k)
        if p is not None:
            code = "32" if p < 70 else ("33" if p < WARN_PCT else "31")
            s = color(f"{lab} {p:.0f}%", code)
            if k == "five_hour" and p >= WARN_PCT and r:
                s += color(f" ↻{datetime.fromtimestamp(r).strftime('%H:%M')}", "2")
            parts.append(s)
    print(" · ".join(parts))


