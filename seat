def cmd_setup(cfg, args):
    """Install the Claude Code status line (settings.json is shared by every seat)."""
    path = DEFAULT_CLAUDE_DIR / "settings.json"
    if not DEFAULT_CLAUDE_DIR.is_dir():
        print("! ~/.claude yok (Claude Code henüz kurulmamış/açılmamış); status line'ı sonra kur: seat setup")
        return
    data = read_json(path, {}) or {}
    sl = data.get("statusLine")
    if sl and "seat" not in json.dumps(sl):
        print(f"! Claude Code'da zaten bir statusLine var, dokunmadım: {sl}")
        print(f"  seat göstergesini istersen komutu şununla değiştir: {statusline_command()}")
        return
    if not sl:
        if path.exists():
            shutil.copy2(path, path.with_name(f"settings.json.seat-bak-{time.strftime('%Y%m%d%H%M%S')}"))
        data["statusLine"] = {"type": "command", "command": statusline_command(), "padding": 0}
        real = path.resolve()
        tmp = real.with_suffix(".json.seat-tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        os.replace(tmp, real)
        print("✓ Claude Code status line kuruldu (hesap · model · 5s/7g limit). Yedek: settings.json.seat-bak-*")
    else:
        print("✓ Claude Code status line zaten seat")


