def link_shared_claude(dst_dir):
    dst_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(dst_dir, 0o700)
    for item in SHARED_CLAUDE_ITEMS:
        src, dst = DEFAULT_CLAUDE_DIR / item, dst_dir / item
        if src.exists() and not dst.exists() and not dst.is_symlink():
            dst.symlink_to(src)


def isolate_hermes_profile(acc):
    """Company seats: own memories, no copy of personal API keys."""
    home = acc.hermes_home
    mem = home / "memories"
    if mem.is_symlink():
        mem.unlink()
    mem.mkdir(exist_ok=True)
    env = home / ".env"
    if env.exists() and env.stat().st_size:
        env.rename(home / f".env.seat-backup-{time.strftime('%Y%m%d%H%M%S')}")
        env.write_text("")
        os.chmod(env, 0o600)


def cmd_add(cfg, args):
    name = email = group = None
    isolated = None
    it = iter(args)
    for a in it:
        if a == "--group":
            group = next(it, None)
        elif a == "--isolated":
            isolated = True
        elif a == "--share":
            isolated = False
        elif "@" in a:
            email = a
        elif not a.startswith("-"):
            name = a
        else:
            die(f"bilinmeyen seçenek: {a}")
    if not email:
        die("kullanım: seat add <ad> <email> [--group G] [--isolated|--share]")
    group = group or group_for(email)
    name = name or group
    if not re.fullmatch(r"[a-z][a-z0-9]{0,23}", name):
        die(f"ad küçük harf + rakam olmalı: '{name}'")
    ex = cfg.get(name)
    if ex and ex.email and ex.email != email:
        die(f"'{name}' adı zaten {ex.email} için kullanılıyor; başka bir ad ver: seat add <ad> {email}")
    if ex and ex.is_default:
        die(f"'{name}' varsayılan hesap")
    if isolated is None:
        isolated = group != cfg.default.group
    acc = ex or Account({"name": name, "email": email, "group": group,
                         "claude_dir": str(HOME / f".claude-{name}"), "hermes_profile": name})
    acc.email, acc.group, acc.isolated = email, group, isolated
    link_shared_claude(acc.claude_dir)
    home = acc.hermes_home
    created = False
    if shutil.which("hermes"):
        if not home.exists():
            subprocess.run(["hermes", "profile", "create", name, "--clone", "--no-alias", "--description",
                            f"Same agent on Claude seat {email} (managed by seat)."],
                           check=True, stdout=subprocess.DEVNULL)
            created = True
        subprocess.run(["hermes", "-p", name, "config", "set", "auth.adopt_external_logins", "false"],
                       check=True, stdout=subprocess.DEVNULL)
        envf = home / ".env"
        if envf.exists():
            kept = [l for l in envf.read_text().splitlines()
                    if not re.match(r"(ANTHROPIC_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=", l)]
            envf.write_text("\n".join(kept) + ("\n" if kept else ""))
        for item in ["skills"] + ([] if isolated else ["memories"]):
            target, link = HERMES_ROOT / item, home / item
            if not target.exists() or link.is_symlink():
                continue
            if link.exists():
                if created:
                    shutil.rmtree(link)
                else:
                    link.rename(home / f"{item}.seat-backup-{time.strftime('%Y%m%d%H%M%S')}")
            link.symlink_to(target)
        if isolated:
            isolate_hermes_profile(acc)
    if not ex:
        cfg.accounts.append(acc)
    cfg.save()
    mode = "izole: kendi hafızası, kişisel API anahtarları yok" if isolated else "hafıza + .env varsayılanla ortak"
    print(f"✓ {acc.label()} eklendi · grup {group} · {mode}")
    print(f"  Giriş: seat login {name}")


