def cmd_login(cfg, args):
    if not args:
        die("kullanım: seat login <ad> [claude|hermes]")
    acc = cfg.need(args[0])
    which = args[1] if len(args) > 1 else "all"
    want = acc.email
    print(f"Giriş yapılacak hesap: {want or '?'}")
    print("claude.ai tarayıcıda başka hesapla açıksa önce oradan hesap değiştir ya da linki gizli pencerede aç.\n")
    if which in ("claude", "all"):
        print(f"── Claude Code ({acc.name})")
        cmd = ["claude", "auth", "login"] + (["--email", want] if want else [])
        subprocess.run(cmd, env=acc.proc_env())
        st = claude_auth_status(acc)
        got = st.get("email") if st.get("loggedIn") else None
        if want and got and got != want:
            subprocess.run(["claude", "auth", "logout"], env=acc.proc_env(), capture_output=True)
            print(color(f"✗ Claude Code {got} ile girdi, {want} bekleniyordu → çıkış yapıldı. Tekrar: seat login {acc.name} claude", "31"))
        elif got:
            print(color(f"✓ Claude Code: {got}", "32"))
    if which in ("hermes", "all"):
        if acc.is_default:
            print(f"── Hermes ({acc.name}) ~/.claude girişini kullanıyor, ayrı giriş gerekmiyor.")
        else:
            print(f"── Hermes ({acc.name}): link açılınca {want} ile onayla, çıkan kodu buraya yapıştır")
            subprocess.run(["hermes", "-p", acc.hermes_profile, "auth", "add", "anthropic", "--type", "oauth",
                            "--label", f"seat-{acc.name}"])
            who = identity(acc)
            if want and who and who.get("email") and who["email"] != want:
                subprocess.run(["hermes", "-p", acc.hermes_profile, "auth", "remove", "anthropic", f"seat-{acc.name}"],
                               capture_output=True)
                print(color(f"✗ Hermes {who['email']} ile girdi, {want} bekleniyordu → bu giriş silindi. Tekrar: seat login {acc.name} hermes", "31"))
            elif who:
                print(color(f"✓ Hermes: {who['email']} · {who.get('org')}", "32"))
    print()
    cmd_status(cfg, [acc.name])


